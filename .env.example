# Public URL of the site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://tenfold.kz

# Lead form email delivery via Resend (https://resend.com)
# 1. Create a Resend account and verify your sending domain.
# 2. Create an API key and paste it here (in Vercel: Project → Settings → Environment Variables).
RESEND_API_KEY=

# Address that receives new inquiries
LEAD_TO_EMAIL=

# Sender shown on notification emails. Must use a domain verified in Resend.
# Until your domain is verified you can use: Tenfold <onboarding@resend.dev>
LEAD_FROM_EMAIL=Tenfold <onboarding@resend.dev>
